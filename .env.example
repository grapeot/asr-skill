# This file is not applied until an asr-skill command loads it.
# Values already set in the process environment win.
# ASR_SKILL_RECORDINGS_DIR and ASR_SKILL_WORK_DIR are not read; pass --input and --work-dir.
ASR_SKILL_DIAR_PYTHON=/path/to/diarization-venv/bin/python
ASR_SKILL_ASR_PYTHON=/path/to/asr-venv/bin/python
ASR_SKILL_EDITOR_TIMEOUT=1800
HF_HOME=/path/to/huggingface-cache
